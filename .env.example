# Gmail search query — adjust to match your job post inbox traffic
# Examples:
#   label:job-applicants
#   subject:(application OR resume OR "job application")
#   from:linkedin.com OR has:attachment filename:pdf
GMAIL_QUERY=label:job-applicants OR subject:(application OR resume OR apply OR portfolio)

# Optional: only fetch emails after this date (YYYY/MM/DD). Leave empty for all matching mail.
GMAIL_AFTER_DATE=

# Max emails per run (safety cap)
GMAIL_MAX_RESULTS=500

# Optional: GitHub personal access token (5,000 req/hr vs 60 without)
# Put in .env or .env.local (both work for the API server)
# GITHUB_TOKEN=ghp_...

# Gmail: credentials.json + token.json at project root (OAuth desktop app).
# Sending email requires gmail.send scope — delete token.json and re-auth after upgrading.

# Sign-off name in default shortlist email ({{team_name}} placeholder)
RECRUITER_TEAM_NAME=Your Company Hiring Team
