# Supabase (required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Postgres — use Supabase connection string (port 5432, direct)
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# Google OAuth (Gmail sync + send)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/gmail/callback
TOKEN_ENCRYPTION_KEY=

# Optional
GITHUB_TOKEN=
GMAIL_QUERY=subject:(application OR resume OR cv)
RECRUITER_TEAM_NAME=Your Team

# Client-side (Vite)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Migration target org (from Supabase organizations table after signup)
ORGANIZATION_ID=
LOCAL_DATA_DIR=./data
