{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": ".cursor/hooks/session-context.sh"
      }
    ],
    "beforeShellExecution": [
      {
        "command": ".cursor/hooks/block-secrets-git.sh",
        "matcher": "git (add|commit|push)"
      }
    ],
    "afterFileEdit": [
      {
        "command": ".cursor/hooks/post-edit-cloud-reminder.sh",
        "matcher": "Write"
      }
    ]
  }
}
